# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
GEMINI_API_KEY=
# Tên model Gemini. Để trống thì dùng mặc định gemini-3.5-flash-lite (agent/core_agent.py).
GEMINI_MODEL=gemini-3.5-flash-lite
# Mỗi quản lý một PIN riêng, dạng Tên:PIN, cách nhau bằng dấu phẩy. Ví dụ dạng: Tên A:mã A,Tên B:mã B
# (tự đặt PIN, không dùng PIN dễ đoán). Đã có MANAGER_PINS thì không cần MANAGER_PIN.
MANAGER_PINS=
# PIN chung dự phòng khi chưa có MANAGER_PINS (tên người đăng nhập vẫn bắt buộc).
MANAGER_PIN=
# Đường dẫn database (mặc định data/bakery.db). Cả nhóm chỉ dùng một tên biến này.
BAKERY_DB_PATH=data/bakery.db
# Giờ demo cố định. Luôn đặt khi chạy init_db và app (dữ liệu mẫu tính hạn lô theo giờ này).
# Dạng YYYY-MM-DDTHH:MM, giữ 08:00. Để trống = giờ thật (KHÔNG dùng khi demo).
DEMO_DATE=2026-11-20T08:00
